APP_NAME="ALL 5.75"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production: use MySQL or PostgreSQL, never SQLite.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=all575
# DB_USERNAME=
# DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=array

# Who may call the API from a browser or the Capacitor app. List every origin explicitly in deployed environments.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost

# Comma-separated load balancer addresses (or * if the platform guarantees the edge). Leave empty when not behind a proxy.
# Rate limits are keyed by client IP, so this must be right in production.
TRUSTED_PROXIES=

# Enable only after the API migration, Firebase project setup and integration tests pass.
# Verified Firebase EMAIL+PASSWORD tokens are exchanged for normal Sanctum customer sessions.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=

# Customer sessions last this many days, then the customer signs in again with a new code.
SESSION_TTL_DAYS=30

# One-time codes. "log" writes the code to storage/logs (local and testing only, refused in production).
# Production needs an SMS and email provider (roadmap decision D-03): until then the API refuses to send codes.
OTP_DRIVER=log

# Payments. "fake" simulates a provider (local and testing only, refused in production).
# Production needs a contracted gateway (roadmap decision D-02): until then checkout answers "payments unavailable".
PAYMENT_DRIVER=fake
FAKE_PAYMENT_WEBHOOK_SECRET=local-development-only

# Unpaid orders hold their stock for this long.
CHECKOUT_RESERVATION_MINUTES=15

# Legal text versions customers must accept. Change these when the Terms or Privacy Policy change.
STORE_TERMS_VERSION=2026-10-29
STORE_PRIVACY_VERSION=2026-10-29
